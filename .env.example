# Public site URL used for canonical / Open Graph / sitemap (required in production)
# Example: https://mestersibiu.vercel.app
NEXT_PUBLIC_SITE_URL=

# Meta Pixel ID — leave empty to keep tracking fully disabled
# Example: 123456789012345
# Never commit a real Pixel ID. Set it in the host environment when ready.
NEXT_PUBLIC_META_PIXEL_ID=

# Future Conversions API (server-only — not wired yet)
# META_CAPI_ACCESS_TOKEN=
